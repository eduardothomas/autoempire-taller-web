// Cloudflare Workers con archivos estáticos (sin código de servidor).
// Build en Cloudflare: `npm run build` · Deploy: `npx wrangler deploy`
{
  "name": "autoempire-taller-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Vista previa por rama: <rama>-autoempire-taller-web.<cuenta>.workers.dev
  "previews": {}
}
